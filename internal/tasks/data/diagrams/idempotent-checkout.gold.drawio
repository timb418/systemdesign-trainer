<mxfile host="app.diagrams.net">
  <diagram id="gold" name="Эталон"><mxGraphModel dx="1200" dy="800" grid="1"><root>
    <mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="client" value="Покупатель" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="190" width="120" height="60" as="geometry"/></mxCell>
    <mxCell id="api" value="Checkout API&#xa;Idempotency-Key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1"><mxGeometry x="190" y="180" width="160" height="80" as="geometry"/></mxCell>
    <mxCell id="db" value="Order + Idempotency&#xa;State + Outbox" style="shape=cylinder3;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="410" y="180" width="170" height="90" as="geometry"/></mxCell>
    <mxCell id="relay" value="Outbox Relay" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="650" y="190" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="inventory" value="Inventory Reserve&#xa;key=order_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="870" y="60" width="160" height="80" as="geometry"/></mxCell>
    <mxCell id="payment" value="Payment Worker" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="870" y="190" width="150" height="60" as="geometry"/></mxCell>
    <mxCell id="provider" value="Провайдер&#xa;stable payment key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1"><mxGeometry x="870" y="340" width="160" height="80" as="geometry"/></mxCell>
    <mxCell id="reconcile" value="Sweeper / Reconciliation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;" vertex="1" parent="1"><mxGeometry x="620" y="350" width="180" height="60" as="geometry"/></mxCell>
    <mxCell id="e1" value="POST checkout + key" edge="1" parent="1" source="client" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e2" value="unique key + request hash" edge="1" parent="1" source="api" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e3" value="pending commands" edge="1" parent="1" source="db" target="relay"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e4" value="reserve command" edge="1" parent="1" source="relay" target="inventory"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e5" value="payment command" edge="1" parent="1" source="relay" target="payment"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e6" value="authorize(order key)" edge="1" parent="1" source="payment" target="provider"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e7" value="CAS order transition" edge="1" parent="1" source="payment" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e8" value="unknown state scan" edge="1" parent="1" source="db" target="reconcile"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e9" value="status by same key" edge="1" parent="1" source="reconcile" target="provider"><mxGeometry relative="1" as="geometry"/></mxCell>
  </root></mxGraphModel></diagram>
