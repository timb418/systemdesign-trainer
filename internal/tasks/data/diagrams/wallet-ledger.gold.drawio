    <mxCell id="e5" value="committed financial events" edge="1" parent="1" source="ledger" target="outbox"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e6" value="deposit / withdrawal command" edge="1" parent="1" source="outbox" target="provider"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e7" value="clearing records" edge="1" parent="1" source="provider" target="reconcile"><mxGeometry relative="1" as="geometry"/></mxCell>
