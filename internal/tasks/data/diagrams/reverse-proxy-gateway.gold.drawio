        <mxCell id="observe" value="Логи • Метрики • Трейсы" style="shape=process;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="740" y="650" width="190" height="60" as="geometry"/>
