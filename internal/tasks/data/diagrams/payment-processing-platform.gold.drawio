<mxfile host="app.diagrams.net">
  <diagram id="gold" name="Эталон"><mxGraphModel dx="1400" dy="900" grid="1"><root>
    <mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="merchant" value="Merchant API Client" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="190" width="150" height="60" as="geometry"/></mxCell>
    <mxCell id="gateway" value="Global API Gateway&#xa;idempotency + region route" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1"><mxGeometry x="210" y="175" width="190" height="90" as="geometry"/></mxCell>
    <mxCell id="vault" value="PCI Token Vault&#xa;PAN boundary" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1"><mxGeometry x="220" y="40" width="170" height="80" as="geometry"/></mxCell>
    <mxCell id="intent" value="Payment Intent Store&#xa;state + outbox RF=3" style="shape=cylinder3;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="460" y="40" width="190" height="90" as="geometry"/></mxCell>
    <mxCell id="orchestrator" value="Payment Orchestrator&#xa;versioned state machine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="460" y="175" width="190" height="90" as="geometry"/></mxCell>
    <mxCell id="router" value="Smart Router&#xa;sticky operation route" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="710" y="180" width="180" height="80" as="geometry"/></mxCell>
    <mxCell id="connectors" value="Provider Connectors&#xa;bulkheads + stable keys" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="950" y="175" width="190" height="90" as="geometry"/></mxCell>
    <mxCell id="providers" value="Acquirers / Wallets / Banks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;" vertex="1" parent="1"><mxGeometry x="1200" y="190" width="180" height="60" as="geometry"/></mxCell>
    <mxCell id="webhook" value="Signed Webhook Inbox" style="shape=process;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="1"><mxGeometry x="960" y="350" width="170" height="60" as="geometry"/></mxCell>
    <mxCell id="ledger" value="Double-entry Ledger&#xa;unique fact inbox + postings&#xa;legal entity / currency" style="shape=cylinder3;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="700" y="335" width="210" height="100" as="geometry"/></mxCell>
    <mxCell id="settlement" value="Settlement + Reconciliation&#xa;Payout / Cases" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="450" y="340" width="200" height="90" as="geometry"/></mxCell>
    <mxCell id="e1" value="Payment Intent + key" edge="1" parent="1" source="merchant" target="gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e2" value="hosted fields / token" edge="1" parent="1" source="merchant" target="vault"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e3" value="unique request + outbox" edge="1" parent="1" source="gateway" target="intent"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e4" value="CAS state transition" edge="1" parent="1" source="intent" target="orchestrator"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e5" value="method/region/risk route" edge="1" parent="1" source="orchestrator" target="router"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e6" value="sticky connector operation" edge="1" parent="1" source="router" target="connectors"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e7" value="authorize/capture/refund" edge="1" parent="1" source="connectors" target="providers"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e8" value="signed async status" edge="1" parent="1" source="providers" target="webhook"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e9" value="deduped normalized event" edge="1" parent="1" source="webhook" target="orchestrator"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e10" value="intent outbox: fact_id(operation, transition)" edge="1" parent="1" source="orchestrator" target="ledger"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e11" value="clearing + payout records" edge="1" parent="1" source="providers" target="settlement"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e12" value="breaks / settled balance" edge="1" parent="1" source="settlement" target="ledger"><mxGeometry relative="1" as="geometry"/></mxCell>
  </root></mxGraphModel></diagram>
